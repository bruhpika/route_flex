# RouteFlex Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─────────────────────────────────────────
# Supabase (required)
# Get from: https://supabase.com/dashboard → Project Settings → API
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────
# Mapbox (required for map rendering)
# Get from: https://account.mapbox.com/access-tokens/
# ─────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─────────────────────────────────────────
# Anthropic Claude (required for AI captions)
# Get from: https://console.anthropic.com/account/keys
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────
# Spotify OAuth (required for music integration)
# Get from: https://developer.spotify.com/dashboard
# Create an app → Settings → Client ID + Client Secret
# Add redirect URI in Spotify app settings:
#   http://localhost:3000/api/auth/spotify/callback  (dev)
#   https://your-domain.com/api/auth/spotify/callback  (prod)
# ─────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback
